# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Auth Provider Flags
# Erst auf true setzen, wenn der Provider im Supabase Dashboard aktiviert ist.
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false
NEXT_PUBLIC_AUTH_APPLE_ENABLED=false

# AI Provider
# Mögliche Werte: mock, openai, anthropic, gemini
AI_PROVIDER=mock

# OpenAI
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_SUMMARY_MODEL=gpt-5.5

# Anthropic Claude
ANTHROPIC_API_KEY=

# Google Gemini
GEMINI_API_KEY=

# App
# Lokal: http://localhost:3000
# Production: https://leaderjournal.de
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Demo
# In npm run dev automatisch aktiv. Für next start/Test-Deploys explizit aktivieren.
DEMO_MODE_ENABLED=false

# Optional
NODE_ENV=development
